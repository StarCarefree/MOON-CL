[Unit]
Description=MoonCL Cloud pack catalog
After=network.target

[Service]
Type=simple
User=mooncl
Group=mooncl
WorkingDirectory=/opt/mooncl
EnvironmentFile=/etc/mooncl/mooncl.env
ExecStart=/usr/bin/java -Xms64m -Xmx256m -jar /opt/mooncl/mooncl-cloud.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=mooncl
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mooncl

[Install]
WantedBy=multi-user.target
