# Include within nginx's http {}. Replace domain and TLS paths before using.
limit_req_zone $binary_remote_addr zone=mooncl_rate:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=mooncl_connections:10m;

upstream mooncl_public {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 443 ssl;
    server_name packs.example.com;
    ssl_certificate /etc/letsencrypt/live/packs.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/packs.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1k;
    limit_req_status 429;
    limit_conn_status 429;
    gzip off; # Application sends precomputed gzip and Vary/ETag; do not transform it.

    location ~ ^/(catalog\.json|healthz|api/v1/packs(/[a-z0-9][a-z0-9_-]{0,63}(/download)?)?)$ {
        limit_except GET { deny all; } # GET also permits HEAD in nginx.
        limit_req zone=mooncl_rate burst=40 nodelay;
        limit_conn mooncl_connections 20;
        proxy_pass http://mooncl_public;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        # Forward Accept-Encoding and response Cache-Control/Vary/ETag unchanged.
    }
    location / { return 404; } # NEVER proxy to 8081 from this public host.
}

server {
    listen 80;
    server_name packs.example.com;
    return 301 https://packs.example.com$request_uri;
}
