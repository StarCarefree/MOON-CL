<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AssetSource Condition="'$(AssetSource)' == ''">$(MSBuildThisFileDirectory)..\..\Plain Craft Launcher 2\Modules\Minecraft\ModAssets.cs</AssetSource>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the production asset scan without starting the launcher or accessing accounts/network. -->
    <Compile Include="$(AssetSource)" Link="ModAssets.cs" />
    <Compile Include="..\..\PCL.Core\Utils\JsonCompat.cs" Link="JsonCompat.cs" />
    <Compile Include="..\..\PCL.Core\Utils\RegexPatterns.cs" Link="RegexPatterns.cs" />
  </ItemGroup>
</Project>
