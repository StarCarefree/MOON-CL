<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LauncherOutput Condition="'$(LauncherOutput)' == ''">../../artifacts/dashboard-build</LauncherOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Plain Craft Launcher 2"><HintPath>$(LauncherOutput)/Plain Craft Launcher 2.dll</HintPath></Reference>
    <Reference Include="PCL.Core"><HintPath>$(LauncherOutput)/PCL.Core.dll</HintPath></Reference>
    <EmbeddedResource Include="../../Plain Craft Launcher 2/metadata.json" LogicalName="PCL.metadata.json" />
  </ItemGroup>
</Project>
