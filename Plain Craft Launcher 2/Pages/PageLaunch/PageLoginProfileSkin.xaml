<Grid x:Class="PCL.PageLoginProfileSkin" Tag="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PCL">
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Modules/HybridUi/HybridTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Grid.Resources>
    <StackPanel Name="PanData" Margin="12" Background="Transparent">
        <local:MySkin HorizontalAlignment="Center" x:Name="Skin" HasCape="False" Margin="0,8,0,16" IsHitTestVisible="False" />
        <TextBlock Name="TextName" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Hybrid.Text}" />
        <TextBlock Name="TextType" Margin="0,6,0,20" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Hybrid.Muted}" />
        <WrapPanel x:Name="PanButtons" HorizontalAlignment="Center">
            <Button x:Name="BtnSkin" Style="{StaticResource Hybrid.QuietButton}" Content="{DynamicResource Launch.Account.ProfileSkin.SkinsAndCapes}" AutomationProperties.AutomationId="Hybrid.Account.SkinsAndCapes">
                <Button.ContextMenu>
                    <ContextMenu>
                        <local:MyMenuItem Click="Skin_Click" Header="{DynamicResource Launch.Account.ProfileSkin.ChangeSkin}" />
                        <local:MyMenuItem Click="BtnSkinSave_Click" Header="{DynamicResource Launch.Account.ProfileSkin.SaveSkin}" />
                        <local:MyMenuItem Click="BtnSkinRefresh_Click" Header="{DynamicResource Launch.Account.ProfileSkin.RefreshSkin}" />
                        <local:MyMenuItem Click="BtnSkinCape_Click" Header="{DynamicResource Launch.Account.ProfileSkin.ChangeCape}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="BtnEdit" Style="{StaticResource Hybrid.QuietButton}" Content="{DynamicResource Launch.Account.ProfileSkin.EditProfile}" AutomationProperties.AutomationId="Hybrid.Account.EditProfile">
                <Button.ContextMenu>
                    <ContextMenu>
                        <local:MyMenuItem Click="BtnEditPassword_Click" Header="{DynamicResource Launch.Account.ProfileSkin.EditPassword}" />
                        <local:MyMenuItem Click="BtnEditName_Click" Header="{DynamicResource Launch.Account.ProfileSkin.EditUsername}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>
    </StackPanel>
</Grid>
