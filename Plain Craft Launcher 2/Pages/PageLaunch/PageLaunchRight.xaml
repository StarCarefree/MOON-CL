<local:MyPageRight x:Class="PCL.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL">
    <local:MyPageRight.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Modules/HybridUi/HybridTheme.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="Dashboard.Button" TargetType="Button" BasedOn="{StaticResource Hybrid.QuietButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#303137" /><Setter TargetName="Plate" Property="BorderBrush" Value="#514533" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Background" Value="#3A3225" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Hybrid.Accent}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </local:MyPageRight.Resources>
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" x:Name="PanBack" Padding="0,0,14,0">
        <StackPanel Name="PanMain" Margin="28,0,24,24" Grid.IsSharedSizeScope="True" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="240" HorizontalAlignment="Right">
                    <Button x:Name="DashboardAdd" Content="＋ 添加组件" Click="DashboardAdd_Click" Style="{StaticResource Hybrid.QuietButton}" Foreground="{StaticResource Hybrid.Accent}" />
                    <Button x:Name="DashboardEdit" Content="编辑布局" Click="DashboardEdit_Click" Style="{StaticResource Hybrid.QuietButton}" />
                </WrapPanel>
            </Grid>
            <Border x:Name="DashboardEditBar" Visibility="Collapsed" Background="#24231F" BorderBrush="#514533" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="正在布置你的空间" Foreground="{StaticResource Hybrid.Accent}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="拖动卡片标题排序，或使用上下移按钮；窄窗口会自动切为单列。" Foreground="{StaticResource Hybrid.Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,8" />
                    <WrapPanel>
                        <Button x:Name="DashboardColumns" Content="布局：双列" Click="DashboardColumns_Click" Style="{StaticResource Hybrid.QuietButton}" />
                        <Button Content="恢复默认" Click="DashboardReset_Click" Style="{StaticResource Hybrid.QuietButton}" />
                        <Button Content="取消" Click="DashboardCancel_Click" Style="{StaticResource Hybrid.QuietButton}" />
                        <Button Content="保存布局" Click="DashboardSave_Click" Style="{StaticResource Hybrid.QuietButton}" Foreground="{StaticResource Hybrid.Accent}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Grid x:Name="DashboardGrid" SizeChanged="DashboardGrid_SizeChanged" />
            <Border x:Name="DashboardEmpty" Visibility="Collapsed" Background="{StaticResource Hybrid.Surface}" BorderBrush="{StaticResource Hybrid.Line}" BorderThickness="1" CornerRadius="10" Padding="28" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="从一张卡片开始" Foreground="{StaticResource Hybrid.Text}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="添加游戏、日历或便签，布置属于你的游戏空间。" Foreground="{StaticResource Hybrid.Muted}" TextWrapping="Wrap" Margin="0,10,0,16" />
                    <Button Content="＋ 选择组件" Click="DashboardAdd_Click" Style="{StaticResource Hybrid.QuietButton}" Foreground="{StaticResource Hybrid.Accent}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="HeroCard" Visibility="Collapsed" CornerRadius="8" BorderBrush="#34302A" BorderThickness="1" ClipToBounds="True">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#252B2D" Offset="0" /><GradientStop Color="#171B1E" Offset="0.65" /><GradientStop Color="#302A20" Offset="1" /></LinearGradientBrush></Border.Background>
                <Grid MinHeight="290">
                    <Path Data="M0,170 L95,80 170,130 270,15 380,95 490,30 620,150 730,85 900,180 900,350 0,350 Z" Stretch="Fill" Fill="#2C4541" Opacity="0.26" Margin="150,55,-40,-10" IsHitTestVisible="False" />
                    <Path Data="M0,190 L100,120 230,160 330,70 440,150 580,80 680,135 790,100 900,170 900,300 0,300 Z" Stretch="Fill" Fill="#0A0E12" Opacity="0.4" Margin="80,125,-40,-10" IsHitTestVisible="False" />
                    <Grid Margin="28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="MINECRAFT JAVA EDITION" Foreground="#D6B372" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,22" />
                        <Grid x:Name="HeroIdentity" Grid.Row="1" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="#252F2D" BorderBrush="#52614A" BorderThickness="1" CornerRadius="8" Width="60" Height="60" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="HeroIconLetter" Text="M" FontSize="30" FontWeight="Bold" Foreground="#D5DFBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="HeroIcon" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="HeroText" Grid.Column="1">
                                <TextBlock x:Name="LabNativeGameName" Foreground="{StaticResource Hybrid.Text}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="84" />
                                <TextBlock x:Name="LabNativeGameDetail" Foreground="#B6BBC1" FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="660" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Background="#242C25" BorderBrush="#3D493C" BorderThickness="1" CornerRadius="4" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="LabNativeGameStatus" Foreground="#C6D4B1" FontSize="11" /></Border>
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button Click="NativeVersions_Click" Content="{DynamicResource Hybrid.VersionList}" Style="{StaticResource Hybrid.QuietButton}" Foreground="{StaticResource Hybrid.Accent}" />
                                <Button x:Name="NativeVersionSettings" Click="NativeVersionSettings_Click" Content="{DynamicResource Hybrid.VersionSettings}" Style="{StaticResource Hybrid.QuietButton}" IsEnabled="False" AutomationProperties.AutomationId="Native.Hero.VersionSettings" />
                                <Button x:Name="NativeVersionFolder" Click="NativeVersionFolder_Click" Content="版本文件夹" Style="{StaticResource Hybrid.QuietButton}" IsEnabled="False" AutomationProperties.AutomationId="Native.Hero.VersionFolder" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel x:Name="PanCustom" Margin="0,0,0,6" />
            <local:MyCard Margin="0,0,0,16" Title="{DynamicResource Launch.Right.CommunityHint.Title}" x:Name="PanHint">
                <local:MyIconButton SvgIcon="lucide/x" Height="20" Width="20" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top" x:Name="BtnHintClose" Click="BtnHintClose_Click" />
                <StackPanel Margin="22,42,22,20">
                    <TextBlock x:Name="LabHint1" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="13" LineHeight="22" />
                    <TextBlock x:Name="LabHint2" TextWrapping="Wrap" FontSize="13" LineHeight="22" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,16" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog">
                <TextBlock x:Name="LabLog" Margin="22,42,22,20" TextWrapping="Wrap" FontSize="13" LineHeight="22" />
            </local:MyCard>
            <Grid x:Name="PanRunning" Margin="0,8,0,0" HorizontalAlignment="Stretch" Visibility="Collapsed" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
