<local:MyPageLeft x:Class="PCL.PageLaunchLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  x:Name="PanBack" Height="160" HorizontalAlignment="Stretch">
    <local:MyPageLeft.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Modules/HybridUi/HybridTheme.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="Launch.DetailLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Hybrid.Muted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Launch.DetailValue" TargetType="TextBlock" BasedOn="{StaticResource Launch.DetailLabel}">
                <Setter Property="Foreground" Value="{StaticResource Hybrid.Text}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
        </ResourceDictionary>
    </local:MyPageLeft.Resources>
    <Border x:Name="LaunchDock" Margin="14,4,24,24" Padding="20,18" Background="#1B1D21" BorderBrush="#51412A" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid Name="PanInput" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="READY TO PLAY / 准备出发" Foreground="{StaticResource Hybrid.Accent}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="LabVersion" Text="{DynamicResource Launch.Home.VersionList.Loading}" Foreground="{StaticResource Hybrid.Text}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,5" />
                    <TextBlock Text="选择你的世界，开始下一段冒险。" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="AprilScaleTrans" /><TranslateTransform x:Name="AprilPosTrans" /></TransformGroup></Grid.RenderTransform>
                    <local:MyButton x:Name="BtnLaunch" Height="70" HorizontalAlignment="Stretch" Text="{DynamicResource Launch.Home.Button.Loading}" ColorType="Highlight" AutomationProperties.AutomationId="Native.StartGame" Click="BtnLaunch_Click" UseHoverScale="True" Padding="30,0,30,0" IsEnabled="False">
                        <local:MyButton.Resources>
                            <SolidColorBrush x:Key="ColorBrush2" Color="#FFB942" />
                            <SolidColorBrush x:Key="ColorBrush3" Color="#FFB942" />
                            <SolidColorBrush x:Key="ColorBrushHalfWhite" Color="#FFB942" />
                            <SolidColorBrush x:Key="ColorBrush1" Color="#16181B" />
                            <SolidColorBrush x:Key="ColorBrush7" Color="#FFCE70" />
                        </local:MyButton.Resources>
                    </local:MyButton>
                    <Border CornerRadius="6" ClipToBounds="True" IsHitTestVisible="False">
                        <Border x:Name="LaunchUpdateFill" Height="70" Width="72" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#8A5A10" Opacity="0.42" IsHitTestVisible="False" Visibility="Collapsed">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>
                <Grid x:Name="PanVersionActions" Visibility="Collapsed">
                    <local:MyButton x:Name="BtnInstance" IsEnabled="False" Click="BtnInstance_Click" Text="{DynamicResource Hybrid.VersionList}" AutomationProperties.AutomationId="Native.VersionList" />
                    <local:MyButton x:Name="BtnMore" IsEnabled="False" Click="BtnMore_Click" Text="{DynamicResource Hybrid.VersionSettings}" AutomationProperties.AutomationId="Native.VersionSettings" />
                </Grid>
                <Grid x:Name="PanLogin" Visibility="Collapsed" />
            </Grid>
            <Grid Name="PanLaunching" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="20" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                    <Viewbox Width="32" Height="36" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <local:MyLoading x:Name="LoadLaunching" AutoRun="False" Width="60" Height="60" Foreground="{StaticResource Hybrid.Accent}">
                            <local:MyLoading.Resources><SolidColorBrush x:Key="ColorBrush3" Color="#FFB942" /></local:MyLoading.Resources>
                        </local:MyLoading>
                    </Viewbox>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="LabLaunchingTitle" Text="{DynamicResource Launch.Status.Title.Launching}" Foreground="{StaticResource Hybrid.Accent}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabLaunchingName" Foreground="{StaticResource Hybrid.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="LabLaunchingProgressLeft" Text="{DynamicResource Launch.Status.LaunchProgress}" Foreground="{StaticResource Hybrid.Muted}" FontSize="10" HorizontalAlignment="Right" />
                        <TextBlock x:Name="LabLaunchingProgress" Text="0%" Foreground="{StaticResource Hybrid.Accent}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </StackPanel>
                    <local:MyButton Grid.Column="4" x:Name="BtnCancel" Height="44" VerticalAlignment="Center" Click="BtnCancel_Click" Text="{DynamicResource Common.Action.Cancel}" AutomationProperties.AutomationId="Native.CancelLaunch" />
                </Grid>
                <Border Grid.Row="1" CornerRadius="3" Background="#34373D" Height="7" Margin="0,12,0,10" ClipToBounds="True">
                    <Grid x:Name="LaunchProgressTrack">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProgressLaunchingFinished" Width="0*" /><ColumnDefinition x:Name="ProgressLaunchingUnfinished" Width="1*" /></Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#CF8A26" Offset="0" /><GradientStop Color="#FFC95E" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" x:Name="PanLaunchingInfo" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Launch.Status.CurrentStep}" Style="{StaticResource Launch.DetailLabel}" />
                    <TextBlock Grid.Column="1" x:Name="LabLaunchingStage" Style="{StaticResource Launch.DetailValue}" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource Launch.Status.LoginMethod}" Style="{StaticResource Launch.DetailLabel}" />
                    <TextBlock Grid.Column="4" x:Name="LabLaunchingMethod" Style="{StaticResource Launch.DetailValue}" />
                    <TextBlock Grid.Column="6" x:Name="LabLaunchingDownloadLeft" Text="{DynamicResource Launch.Status.DownloadSpeed}" Style="{StaticResource Launch.DetailLabel}" Visibility="Collapsed" Opacity="0" />
                    <TextBlock Grid.Column="7" x:Name="LabLaunchingDownload" Style="{StaticResource Launch.DetailValue}" Visibility="Collapsed" Opacity="0" />
                </Grid>
                <Grid Grid.Row="2" x:Name="PanLaunchingHint" Background="#1B1D21" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Launch.Status.Trivia}" Style="{StaticResource Launch.DetailLabel}" />
                    <TextBlock Grid.Column="1" x:Name="LabLaunchingHint" TextTrimming="CharacterEllipsis" Style="{StaticResource Launch.DetailValue}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</local:MyPageLeft>
