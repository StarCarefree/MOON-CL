<UserControl x:Class="PCL.HybridFriends"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Friends_KeyDown">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="HybridTheme.xaml" /></ResourceDictionary.MergedDictionaries>
   <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="#EEECE5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
   </Style>
   <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#ADA99F"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,14,0,7"/>
   </Style>
   <Style TargetType="TextBox">
    <Setter Property="Background" Value="#151719"/><Setter Property="Foreground" Value="#EEECE5"/>
    <Setter Property="BorderBrush" Value="#3D3E3C"/><Setter Property="CaretBrush" Value="#D9BC75"/>
    <Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="SelectionBrush" Value="#796338"/>
   </Style>
   <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#EEECE5"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="0,6,16,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="Box" Width="16" Height="16" Background="#151719" BorderBrush="#6D6A60" BorderThickness="1" CornerRadius="4">
       <TextBlock x:Name="Mark" Text="✓" Foreground="#171819" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Border>
      <ContentPresenter Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Box" Property="Background" Value="#D0AF64"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="#D0AF64"/>
       <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#D9BC75"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="#292B2E"/><Setter Property="Foreground" Value="#EEECE5"/>
    <Setter Property="Padding" Value="8,5"/>
   </Style>
   <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#EEECE5"/><Setter Property="Background" Value="#292B2E"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border Background="#292B2E" BorderBrush="#49473F" BorderThickness="1" CornerRadius="5">
         <DockPanel Margin="10,7"><TextBlock DockPanel.Dock="Right" Text="▾"/>
          <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
         </DockPanel>
        </Border>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="False">
       <Border Background="#292B2E" BorderBrush="#49473F" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
        <StackPanel IsItemsHost="True"/>
       </Border>
      </Popup>
     </Grid>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource Hybrid.QuietButton}">
    <Setter Property="Background" Value="#2D2F30"/><Setter Property="Foreground" Value="#CCC9C0"/>
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,5"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
   </Style>
   <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource Action}">
    <Setter Property="Padding" Value="2,5"/><Setter Property="Margin" Value="2,0"/>
    <Setter Property="Background" Value="Transparent"/>
   </Style>
   <Style x:Key="ActiveTab" TargetType="Button" BasedOn="{StaticResource Tab}">
    <Setter Property="Background" Value="#393328"/><Setter Property="Foreground" Value="#D9BC75"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
   </Style>
   <Style x:Key="Gold" TargetType="Button" BasedOn="{StaticResource Action}">
    <Setter Property="Background" Value="#D0AF64"/><Setter Property="Foreground" Value="#171819"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
   </Style>
   <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="#202224"/><Setter Property="BorderBrush" Value="#353735"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
   </Style>
   <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
   </Style>
   <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="6,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#2C2E2D"/></Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Row" Property="Background" Value="#373229"/>
       <Setter TargetName="Row" Property="BorderBrush" Value="#635334"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#D9BC75"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Background="#1B1D1F">
  <Grid x:Name="Workspace" Margin="20,16,20,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16">
    <Button DockPanel.Dock="Right" Content="服务与隐私" Style="{StaticResource Action}" Margin="12,0,0,0" VerticalAlignment="Center" Click="ToggleSettings_Click" AutomationProperties.AutomationId="Friends.Settings"/>
    <StackPanel>
     <TextBlock Text="好友与聊天" FontWeight="SemiBold" FontSize="23"/>
     <TextBlock x:Name="Identity" Margin="0,5,0,0" Foreground="#ADA99F" FontSize="12" Text="未连接 · 登录正版账号后与好友保持联系"/>
    </StackPanel>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="220" MaxWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <!-- Contacts and conversations stay in one compact navigation rail. -->
    <Border Style="{StaticResource Card}">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.2*" MaxHeight="140"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="14,14,14,12">
       <Button DockPanel.Dock="Right" Content="＋ 添加" Style="{StaticResource Gold}" Margin="6,0,0,0" Click="ToggleAdd_Click" AutomationProperties.AutomationId="Friends.Add"/>
       <TextBlock Text="联系人" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="12,0,12,12">
       <TextBox x:Name="Search" TextChanged="Search_Changed" AutomationProperties.Name="搜索好友" AutomationProperties.AutomationId="Friends.Search"/>
       <TextBlock Text="搜索好友名字…" Margin="11,0" Foreground="#86877F" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <StackPanel Grid.Row="2">
       <UniformGrid Columns="4" Margin="10,0,10,10">
        <Button x:Name="OnlineTab" Content="在线" Style="{StaticResource ActiveTab}" Click="Tab_Click" Tag="online" AutomationProperties.AutomationId="Friends.Online"/>
        <Button x:Name="AllTab" Content="全部" Style="{StaticResource Tab}" Click="Tab_Click" Tag="all" AutomationProperties.AutomationId="Friends.All"/>
        <Button x:Name="PendingTab" Content="申请" Style="{StaticResource Tab}" Click="Tab_Click" Tag="pending" AutomationProperties.AutomationId="Friends.Pending"/>
        <Button x:Name="BlockedTab" Content="拉黑" Style="{StaticResource Tab}" Click="Tab_Click" Tag="blocked" AutomationProperties.AutomationId="Friends.Blocked"/>
       </UniformGrid>
       <DockPanel Margin="16,0,16,8">
        <TextBlock x:Name="PeopleCount" DockPanel.Dock="Right" Foreground="#86877F" FontSize="11"/>
        <TextBlock x:Name="ListTitle" Text="在线好友" Foreground="#ADA99F" FontSize="11"/>
       </DockPanel>
      </StackPanel>
      <Grid Grid.Row="3">
       <ListBox x:Name="People" SelectionChanged="People_Changed" AutomationProperties.AutomationId="Friends.People">
        <ListBox.ItemTemplate><DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="32" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left">
           <Border Background="#414137" CornerRadius="10"><TextBlock Text="{Binding Initial}" FontSize="15" Foreground="#D9BC75" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
           <Ellipse Width="9" Height="9" Stroke="#202224" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#777B7B"/>
             <Style.Triggers><DataTrigger Binding="{Binding State}" Value="在线"><Setter Property="Fill" Value="#8BBF9F"/></DataTrigger>
              <DataTrigger Binding="{Binding Kind}" Value="incoming"><Setter Property="Fill" Value="#D9BC75"/></DataTrigger>
             </Style.Triggers>
            </Style></Ellipse.Style>
           </Ellipse>
          </Grid>
          <StackPanel Grid.Column="1">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
           <TextBlock Text="{Binding Playing}" FontSize="11" Foreground="#D9BC75" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Playing}"/>
           <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#86877F" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
          </StackPanel>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="PeopleEmpty" Text="这里还没有在线好友" Foreground="#86877F" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" TextAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=People}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Border Grid.Row="4" BorderBrush="#353735" BorderThickness="0,1,0,0" Padding="16,12,16,6">
       <TextBlock Text="最近会话 / 频道邀请" Foreground="#ADA99F" FontSize="11"/>
      </Border>
      <Grid Grid.Row="5" Margin="0,0,0,8">
       <ListBox x:Name="Channels" SelectionChanged="Channel_Changed" AutomationProperties.AutomationId="Friends.Channels">
        <ListBox.ItemTemplate><DataTemplate>
         <DockPanel>
          <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Background="#303330" Margin="0,0,9,0">
           <TextBlock Text="{Binding Initial}" Foreground="#D9BC75" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
         </DockPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="还没有会话，选择好友开始聊天" Foreground="#86877F" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" TextAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Channels}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
      </Grid>
     </Grid>
    </Border>
    <!-- The chat surface owns both relationship actions and channel actions. -->
    <Border Grid.Column="2" Style="{StaticResource Card}" Background="#1D1F21">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="#353735" BorderThickness="0,0,0,1" Padding="18,15,18,10">
       <StackPanel>
        <TextBlock x:Name="ChatTitle" Text="开始一段聊天" FontWeight="SemiBold" FontSize="18" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ChatSubtitle" Text="从左侧选择好友或最近会话" Margin="0,5,0,8" Foreground="#ADA99F" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
        <WrapPanel>
         <Button x:Name="ChatButton" Content="打开私聊" Style="{StaticResource Gold}" Visibility="Collapsed" Click="Chat_Click" AutomationProperties.AutomationId="Friends.Chat"/>
         <Button x:Name="InviteRoomButton" Content="邀请进房" Style="{StaticResource Gold}" Visibility="Collapsed" Click="InviteRoom_Click" AutomationProperties.AutomationId="Friends.InviteRoom"/>
         <Button x:Name="JoinButton" Content="加入服务器" Style="{StaticResource Action}" Visibility="Collapsed" Click="Join_Click" AutomationProperties.AutomationId="Friends.Join"/>
         <Button x:Name="AcceptButton" Content="接受申请" Style="{StaticResource Gold}" Visibility="Collapsed" Click="Accept_Click" AutomationProperties.AutomationId="Friends.Accept"/>
         <Button x:Name="DenyButton" Content="拒绝" Style="{StaticResource Action}" Visibility="Collapsed" Click="Remove_Click" AutomationProperties.AutomationId="Friends.Deny"/>
         <Button x:Name="CancelButton" Content="取消申请" Style="{StaticResource Action}" Visibility="Collapsed" Click="Remove_Click" AutomationProperties.AutomationId="Friends.Cancel"/>
         <Button x:Name="UnblockButton" Content="取消拉黑" Style="{StaticResource Action}" Visibility="Collapsed" Click="Remove_Click" AutomationProperties.AutomationId="Friends.Unblock"/>
         <Button x:Name="RemoveButton" Content="删除好友" Style="{StaticResource Action}" Visibility="Collapsed" Click="Remove_Click" AutomationProperties.AutomationId="Friends.Remove"/>
         <Button x:Name="BlockButton" Content="拉黑" Style="{StaticResource Action}" Visibility="Collapsed" Click="Block_Click" AutomationProperties.AutomationId="Friends.Block"/>
         <Button x:Name="AcceptInviteButton" Content="接受频道" Style="{StaticResource Gold}" Visibility="Collapsed" Click="AcceptInvite_Click" AutomationProperties.AutomationId="Friends.AcceptInvite"/>
         <Button x:Name="IgnoreInviteButton" Content="忽略邀请" Style="{StaticResource Action}" Visibility="Collapsed" Click="IgnoreInvite_Click" AutomationProperties.AutomationId="Friends.IgnoreInvite"/>
         <Button x:Name="LeaveButton" Content="离开会话" Style="{StaticResource Action}" Visibility="Collapsed" Click="Leave_Click" AutomationProperties.AutomationId="Friends.Leave"/>
        </WrapPanel>
       </StackPanel>
      </Border>
      <Grid Grid.Row="1">
       <ListBox x:Name="Messages" Padding="10,14" AutomationProperties.AutomationId="Friends.Messages">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
         <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
         <Setter Property="Padding" Value="4,5"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
         <Border x:Name="Bubble" Background="#2B2E30" CornerRadius="9,9,9,2" Padding="12,9" HorizontalAlignment="Left" MaxWidth="520">
          <StackPanel>
           <DockPanel Margin="0,0,0,5">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="#9B9A90" FontSize="10" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding Sender}" Foreground="#D9BC75" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </DockPanel>
           <TextBlock Text="{Binding Content}" FontSize="13"/>
          </StackPanel>
         </Border>
         <DataTemplate.Triggers><DataTrigger Binding="{Binding Mine}" Value="True">
          <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
          <Setter TargetName="Bubble" Property="Background" Value="#383326"/>
          <Setter TargetName="Bubble" Property="CornerRadius" Value="9,9,2,9"/>
         </DataTrigger></DataTemplate.Triggers>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <StackPanel x:Name="ChatEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
        <Border Width="54" Height="48" Background="#2E2E28" CornerRadius="16" Margin="0,0,0,14">
         <TextBlock Text="聊" Foreground="#D9BC75" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="ChatEmptyTitle" Text="与好友保持联系" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
        <TextBlock x:Name="ChatEmptyHint" Text="选择左侧好友即可私聊，也可以添加新的好友。" Foreground="#86877F" FontSize="12" Margin="0,8,0,0" TextAlignment="Center"/>
       </StackPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#353735" BorderThickness="0,1,0,0" Padding="14,12">
       <StackPanel>
        <TextBox x:Name="Composer" MaxLength="2000" MinHeight="60" MaxHeight="104" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsEnabled="False" PreviewKeyDown="Composer_KeyDown" TextChanged="Composer_Changed" AutomationProperties.Name="聊天消息" AutomationProperties.AutomationId="Friends.Composer"/>
        <DockPanel Margin="0,8,0,0">
         <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送" Style="{StaticResource Gold}" Margin="12,0,0,0" MinWidth="72" IsEnabled="False" Click="Send_Click" AutomationProperties.AutomationId="Friends.Send"/>
         <TextBlock Text="Enter 发送 · Shift + Enter 换行" Foreground="#86877F" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
   </Grid>
   <TextBlock x:Name="Status" Grid.Row="2" Margin="2,10,2,0" Foreground="#ADA99F" FontSize="11" MaxHeight="32" TextTrimming="CharacterEllipsis" Text="选择好友即可聊天；在「申请」中处理好友请求。" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
  <!-- In-page modal: background input is disabled and keyboard focus stays in the dialog. -->
  <Grid x:Name="Overlay" Visibility="Collapsed" Background="#B3101214" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.AutomationId="Friends.Overlay">
   <Border x:Name="OverlayFrame" Style="{StaticResource Card}" Background="#252729" MaxWidth="500" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="22">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12">
      <Button x:Name="CloseOverlayButton" DockPanel.Dock="Right" Content="×" FontSize="19" Width="32" Style="{StaticResource Action}" Margin="12,0,0,0" ToolTip="关闭（Esc）" AutomationProperties.Name="关闭弹窗" Click="CloseOverlay_Click" AutomationProperties.AutomationId="Friends.CloseOverlay"/>
      <TextBlock x:Name="OverlayTitle" Text="添加好友" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <StackPanel x:Name="AddPanel" Visibility="Collapsed">
        <TextBlock Text="让下一次冒险不再独行" Foreground="#ADA99F" Margin="0,0,0,8"/>
        <TextBlock Text="正版用户名或 UUID" Style="{StaticResource Label}"/>
        <TextBox x:Name="Target" MaxLength="36" PreviewKeyDown="Target_KeyDown" AutomationProperties.Name="正版用户名或 UUID" AutomationProperties.AutomationId="Friends.Target"/>
        <TextBlock Text="自动识别输入类型。对方接受申请后，你们就可以开始聊天。" Foreground="#86877F" FontSize="12" Margin="0,9,0,20"/>
        <Button x:Name="RequestButton" Content="发送好友申请" Style="{StaticResource Gold}" HorizontalAlignment="Right" Margin="0" MinWidth="130" Click="Request_Click" AutomationProperties.AutomationId="Friends.Request"/>
       </StackPanel>
       <StackPanel x:Name="Settings" Visibility="Collapsed">
        <TextBlock Text="好友服务" Style="{StaticResource Label}"/>
        <ComboBox x:Name="Service" SelectedIndex="0" SelectionChanged="Service_Changed" AutomationProperties.AutomationId="Friends.Service">
         <ComboBoxItem Content="官方 Axolotl"/><ComboBoxItem Content="自定义服务"/>
        </ComboBox>
        <TextBox x:Name="CustomUrl" Visibility="Collapsed" Margin="0,8,0,0" TextChanged="CustomUrl_Changed" AutomationProperties.Name="自定义服务地址" AutomationProperties.AutomationId="Friends.CustomUrl"/>
        <TextBlock Text="自定义地址须兼容同一套 API，填错不会改回官方。" Foreground="#86877F" FontSize="11" Margin="0,8,0,8"/>
        <TextBlock Text="账号隐私" Style="{StaticResource Label}"/>
        <WrapPanel>
         <CheckBox x:Name="ShowRegistered" Content="公开注册时间" Checked="Privacy_Changed" Unchecked="Privacy_Changed"/>
         <CheckBox x:Name="RetainUsernames" Content="保留曾用名" Checked="Privacy_Changed" Unchecked="Privacy_Changed"/>
         <CheckBox x:Name="ShowLastOnline" Content="公开上次在线" Checked="Privacy_Changed" Unchecked="Privacy_Changed"/>
         <CheckBox x:Name="ShowActivity" Content="公开当前活动" Checked="Privacy_Changed" Unchecked="Privacy_Changed"/>
         <CheckBox x:Name="AllowImages" Content="允许好友查看图片" Checked="Privacy_Changed" Unchecked="Privacy_Changed"/>
         <CheckBox x:Name="FriendNotices" Content="接收好友通知" IsChecked="True" Checked="Notice_Changed" Unchecked="Notice_Changed"/>
        </WrapPanel>
        <TextBlock Text="更改会自动保存。" Foreground="#86877F" FontSize="11" Margin="0,14,0,0"/>
       </StackPanel>
       <StackPanel x:Name="ActivityPanel" Visibility="Collapsed">
        <TextBlock x:Name="ActivitySummary" Foreground="#D9BC75" FontWeight="SemiBold"/>
        <TextBlock x:Name="ActivityDetail" Foreground="#ADA99F" Margin="0,6,0,14"/>
        <TextBlock Text="游玩记录" Style="{StaticResource Label}"/>
        <ListBox x:Name="ActivityHistory" MaxHeight="280" AutomationProperties.AutomationId="Friends.ActivityHistory">
         <ListBox.ItemTemplate><DataTemplate>
          <DockPanel>
           <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="#86877F" FontSize="11" Margin="12,0,0,0"/>
           <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Detail}" Foreground="#ADA99F" FontSize="11" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </DockPanel>
         </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ActivityEmpty" Text="还没有看到这位好友的游玩记录" Foreground="#86877F" Margin="0,10,0,0"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="#3D3E3C" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
      <TextBlock Text="{Binding Text, ElementName=Status}" Foreground="#D9BC75" FontSize="12" AutomationProperties.AutomationId="Friends.DialogStatus"/>
     </Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
