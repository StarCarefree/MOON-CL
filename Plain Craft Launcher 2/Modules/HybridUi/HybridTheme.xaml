<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PCL">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="HybridScrollbars.xaml" /></ResourceDictionary.MergedDictionaries>
    <!-- Shared charcoal/gold styling; native page resources use UnifiedDesktopPalette. -->
    <SolidColorBrush x:Key="Hybrid.Background" Color="#111315" />
    <SolidColorBrush x:Key="Hybrid.Sidebar" Color="#0A0B0D" />
    <SolidColorBrush x:Key="Hybrid.Surface" Color="#1B1D21" />
    <SolidColorBrush x:Key="Hybrid.Line" Color="#2A2D32" />
    <SolidColorBrush x:Key="Hybrid.Text" Color="#ECEDEF" />
    <SolidColorBrush x:Key="Hybrid.Muted" Color="#9299A3" />
    <SolidColorBrush x:Key="Hybrid.Accent" Color="#FFB942" />

    <Style x:Key="Hybrid.Nav" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Hybrid.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Plate" CornerRadius="6" Background="{TemplateBinding Background}" />
                        <Border x:Name="Surface" CornerRadius="6" Background="#202226" Opacity="0"
                                RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <Border x:Name="Marker" Width="3" Height="25" HorizontalAlignment="Left"
                                Background="{StaticResource Hybrid.Accent}" CornerRadius="1.5" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:HybridNavigation.IsActive" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#242629" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Hybrid.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Hybrid.Accent}" />
                            <Setter TargetName="Plate" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hybrid.QuietButton" TargetType="Button" BasedOn="{StaticResource Hybrid.Nav}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Hybrid.VersionItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Hybrid.Muted}" />
        <Setter Property="Padding" Value="18,7,6,7" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Plate" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect x:Name="LaunchGlow" Color="#FFB942" BlurRadius="0" ShadowDepth="0" Opacity="0" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Surface" CornerRadius="6" Background="#24272C" BorderBrush="#3A3E45" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#292721" />
                            <Setter Property="Foreground" Value="{StaticResource Hybrid.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Hybrid.Accent}" />
                            <Setter TargetName="Plate" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Hybrid.Accent}" />
                            <Setter TargetName="Plate" Property="Background" Value="#2A2214" />
                            <Setter Property="Foreground" Value="{StaticResource Hybrid.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="LaunchPulse">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="LaunchGlow" Storyboard.TargetProperty="Opacity" From="0.28" To="1" Duration="0:0:0.7" />
                                        <DoubleAnimation Storyboard.TargetName="LaunchGlow" Storyboard.TargetProperty="BlurRadius" From="5" To="16" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LaunchPulse" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hybrid.VersionGear" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#2A2D32" />
        <Setter Property="Foreground" Value="{StaticResource Hybrid.Muted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" Width="22" Height="22" CornerRadius="11" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#3A3328" />
                            <Setter Property="Foreground" Value="{StaticResource Hybrid.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
