<UserControl x:Class="PCL.HybridLaunchScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111315" Visibility="Collapsed" IsVisibleChanged="VisibilityChanged" Unloaded="ViewUnloaded">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="HybridTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20">
        <Grid MaxWidth="760" MinWidth="240" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <StackPanel><TextBlock Text="MOONCL / LAUNCH SEQUENCE" Foreground="{StaticResource Hybrid.Accent}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="下一站，你的世界" Foreground="{StaticResource Hybrid.Text}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
            </Grid>
            <Border Grid.Row="1" CornerRadius="10" BorderBrush="#3E372A" BorderThickness="1" ClipToBounds="True">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#23282B" /><GradientStop Color="#171B1E" Offset="0.6" /><GradientStop Color="#30291E" Offset="1" /></LinearGradientBrush></Border.Background>
                <Grid>
                    <Viewbox Height="182" Stretch="Uniform" ClipToBounds="True" IsHitTestVisible="False">
                        <Canvas Width="640" Height="182">
                            <Ellipse Width="2" Height="2" Fill="#ACA894" Canvas.Left="92" Canvas.Top="34" /><Ellipse Width="3" Height="3" Fill="#D6B372" Canvas.Left="482" Canvas.Top="46" /><Ellipse Width="2" Height="2" Fill="#898C87" Canvas.Left="540" Canvas.Top="98" /><Ellipse Width="2" Height="2" Fill="#898C87" Canvas.Left="168" Canvas.Top="100" />
                            <Ellipse Width="156" Height="156" Stroke="#4C4433" StrokeThickness="1" Canvas.Left="242" Canvas.Top="6" />
                            <Ellipse Width="118" Height="118" Stroke="#353C3B" StrokeThickness="1" Canvas.Left="261" Canvas.Top="25" />
                            <Grid x:Name="Orbit" Width="156" Height="156" Canvas.Left="242" Canvas.Top="6" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="OrbitRotation" /></Grid.RenderTransform><Ellipse Width="7" Height="7" Fill="#FFB942" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0" /></Grid>
                            <Path Data="M 339,56 A 35,35 0 1 0 339,112 A 30,30 0 0 1 339,56 Z" Fill="#E6C58B" />
                            <Path Data="M0,157 L70,118 132,152 226,111 290,158 397,115 480,151 560,117 640,157 640,182 0,182 Z" Fill="#2C3C38" />
                            <Path Data="M0,173 L90,153 178,173 264,140 355,177 453,143 543,170 640,146 640,182 0,182 Z" Fill="#151D20" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="PREPARING YOUR NEXT ADVENTURE" FontSize="9" Foreground="#7F898A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,16,12" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock x:Name="VersionName" Foreground="{StaticResource Hybrid.Text}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LaunchTitle" Text="正在启动游戏" Foreground="{StaticResource Hybrid.Muted}" FontSize="12" Margin="0,6,0,18" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StageName" Text="初始化" Foreground="{StaticResource Hybrid.Text}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                    <TextBlock x:Name="Percentage" Grid.Column="1" Text="0%" Foreground="{StaticResource Hybrid.Accent}" FontSize="26" FontFamily="Consolas" />
                </Grid>
                <Border Height="4" Background="#303237" CornerRadius="2" ClipToBounds="True" SizeChanged="ProgressSizeChanged">
                    <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" Background="{StaticResource Hybrid.Accent}" CornerRadius="2" />
                </Border>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DownloadSpeed" Text="正在准备启动环境" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock x:Name="Elapsed" Grid.Column="1" Text="00:00" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" FontFamily="Consolas" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,22,0,0">
                <Border Background="#1B1D21" BorderBrush="#2A2D32" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                    <TextBlock Text="启动进度来自实际任务；游戏窗口出现后，启动器将按你的设置自动处理。" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="18" />
                </Border>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="返回主页" Click="HomeClick" AutomationProperties.AutomationId="LaunchScreen.Home" Style="{StaticResource Hybrid.QuietButton}" ToolTip="仅收起动画，启动任务继续运行" Margin="0,0,8,0" />
                    <Button Content="取消启动" Click="CancelClick" AutomationProperties.AutomationId="LaunchScreen.Cancel" Style="{StaticResource Hybrid.QuietButton}" Foreground="{StaticResource Hybrid.Accent}" Background="#302719" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
