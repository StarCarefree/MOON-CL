<UserControl x:Class="PCL.HybridRooms"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib"
 FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
 PreviewKeyDown="Lobby_KeyDown" SizeChanged="Lobby_SizeChanged">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="HybridTheme.xaml" /></ResourceDictionary.MergedDictionaries>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEECE5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="Label" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#ADA99F"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,8,0,4"/></Style>
   <Style TargetType="TextBox"><Setter Property="Background" Value="#151719"/><Setter Property="Foreground" Value="#EEECE5"/><Setter Property="BorderBrush" Value="#49473F"/><Setter Property="CaretBrush" Value="#D9BC75"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="MaxLength" Value="253"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/></Style>
   <Style TargetType="PasswordBox"><Setter Property="Background" Value="#151719"/><Setter Property="Foreground" Value="#EEECE5"/><Setter Property="BorderBrush" Value="#49473F"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="MaxLength" Value="128"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/></Style>
   <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#292B2E"/><Setter Property="Foreground" Value="#EEECE5"/><Setter Property="Padding" Value="8,5"/></Style>
   <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#EEECE5"/><Setter Property="Background" Value="#292B2E"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="MaxDropDownHeight" Value="240"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#292B2E" BorderBrush="#49473F" BorderThickness="1" CornerRadius="4"><Grid Margin="8,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Border x:Name="ChoiceFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
       <Border Background="#292B2E" BorderBrush="#49473F" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="620"><ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ChoiceFocus" Property="BorderBrush" Value="#D9BC75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource Hybrid.QuietButton}">
    <Setter Property="Background" Value="#343432"/><Setter Property="Foreground" Value="#EEECE5"/>
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="BorderBrush" Value="#A28C58"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.72"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionSurface" Property="BorderBrush" Value="#EEECE5"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Gold" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#D0AF64"/><Setter Property="Foreground" Value="#171819"/><Setter Property="FontWeight" Value="Bold"/></Style>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#252729"/><Setter Property="BorderBrush" Value="#44423A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
   <Style TargetType="TabControl"><Setter Property="Background" Value="#252729"/><Setter Property="BorderBrush" Value="#49473F"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="TabItem"><Setter Property="Foreground" Value="#EEECE5"/><Setter Property="Background" Value="#343432"/><Setter Property="Padding" Value="12,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#49473F" BorderThickness="1"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#6A5934"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="RouteBorder" BorderThickness="2,0,0,0" BorderBrush="Transparent" Background="#202224">
        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RouteBorder" Property="Background" Value="#2C2D2B"/></Trigger>
        <Trigger Property="IsSelected" Value="True">
         <Setter TargetName="RouteBorder" Property="Background" Value="#39352A"/>
         <Setter TargetName="RouteBorder" Property="BorderBrush" Value="#D9BC75"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RouteBorder" Property="BorderBrush" Value="#EEECE5"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <sys:Double x:Key="RoomAvatarSize">48</sys:Double>
   <!-- Preserve the native charcoal/gold palette; interaction feedback is immediate, without motion. -->
   <Style x:Key="EntryCard" TargetType="Button" BasedOn="{StaticResource Hybrid.QuietButton}">
    <Setter Property="Height" Value="Auto"/>
    <Setter Property="Padding" Value="24"/>
    <Setter Property="Background" Value="#252729"/>
    <Setter Property="Foreground" Value="#EEECE5"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="Button">
       <Border x:Name="EntrySurface" Background="{TemplateBinding Background}" BorderBrush="#44423A"
               BorderThickness="2" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
         <Setter TargetName="EntrySurface" Property="Background" Value="#302F29"/>
         <Setter TargetName="EntrySurface" Property="BorderBrush" Value="#A28C58"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
         <Setter TargetName="EntrySurface" Property="Background" Value="#393326"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
         <Setter TargetName="EntrySurface" Property="BorderBrush" Value="#D9BC75"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <DataTemplate x:Key="MemberTemplate">
    <Border Margin="2" Padding="2" Background="#202224" CornerRadius="4" ToolTip="{Binding Game}">
     <Grid VerticalAlignment="Center">
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="16"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid HorizontalAlignment="Center" Width="48" Height="48">
       <Border Background="#41423F" CornerRadius="4">
        <Grid>
         <TextBlock Text="{Binding Initials}" Foreground="#EEECE5" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Avatar}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
         <Image Source="{Binding Avatar}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
        </Grid>
       </Border>
       <Border Background="#E61B1D1F" VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="2" Padding="2,0" ToolTip="{Binding Role}">
        <TextBlock Text="{Binding Role}" Foreground="#D9BC75" FontSize="12" MaxWidth="44" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
       </Border>
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#EEECE5" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      <TextBlock Grid.Row="2" Text="{Binding Game}" FontSize="12" Foreground="#ADA99F" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      <Button Grid.Row="3" Content="跟随队友" Height="22" FontSize="12" Padding="4,0" Margin="0" HorizontalAlignment="Stretch" Click="JoinMemberServer_Click" ToolTip="{Binding JoinServerLabel}" AutomationProperties.AutomationId="Rooms.JoinMemberServer">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanJoinServer}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
     </Grid>
    </Border>
   </DataTemplate>
   <DataTemplate x:Key="EmptySeatTemplate">
    <Border Margin="3" Padding="4" Background="#202224" BorderBrush="#363733" BorderThickness="1" CornerRadius="8">
     <Border.Style>
      <Style TargetType="Border">
       <Style.Triggers><DataTrigger Binding="{Binding}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers>
      </Style>
     </Border.Style>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="＋" FontSize="24" Foreground="#706D63" TextAlignment="Center"/>
      <TextBlock Text="等待队友" FontSize="11" Foreground="#827F75" TextAlignment="Center" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="LobbyRoot" Background="#1B1D1F">
  <Grid x:Name="LobbyContent" Margin="12">
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <!-- One quiet page header; operational status has no separate banner or layout track. -->
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="好友联机" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" x:Name="IdentitySummary" MaxWidth="120" Margin="12,0,0,0" Foreground="#ADA99F" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock Grid.Column="2" x:Name="Status" Text="创建或加入房间，和朋友一起玩。" Margin="16,0,12,0" FontSize="12" Foreground="#ADA99F" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="Rooms.Status" AutomationProperties.LiveSetting="Polite"/>
    <Button Grid.Column="3" Content="设置" Style="{StaticResource Action}" Margin="0" Click="OpenSettings_Click" AutomationProperties.AutomationId="Rooms.OpenSettings"/>
   </Grid>
   <Grid Grid.Row="2" x:Name="HallPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="4,16,0,24"><TextBlock Text="和朋友，共享一个世界。" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="创建好友房间，或凭邀请码与队友会合。" Foreground="#ADA99F" Margin="0,8,0,0"/></StackPanel>
    <Border Grid.Row="1" x:Name="CurrentCard" Style="{StaticResource Card}" Visibility="Collapsed">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="当前房间 · 连接保持中" Foreground="#D9BC75"/>
      <StackPanel Grid.Row="1" Margin="0,12"><TextBlock x:Name="CurrentTitle" FontSize="20" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="CurrentHostGame" Margin="0,4,0,0" Foreground="#ADA99F" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
      <ItemsControl Grid.Row="2" x:Name="HallMembers" ItemTemplate="{StaticResource MemberTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="返回房间" Click="Reenter_Click" Style="{StaticResource Gold}" AutomationProperties.AutomationId="Rooms.Reenter"/><Button x:Name="HallLeaveButton" Content="退出房间" Click="Leave_Click" Style="{StaticResource Action}" AutomationProperties.AutomationId="Rooms.HallLeave"/></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1" x:Name="EntryForms">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource EntryCard}" Click="OpenCreate_Click" AutomationProperties.AutomationId="Rooms.OpenCreate" AutomationProperties.Name="创建房间">
      <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="由你发起" Foreground="#D9BC75"/><TextBlock Text="创建房间" FontSize="24" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="起个名字，邀请朋友。&#10;进入房间后再准备游戏与线路。" Foreground="#ADA99F"/></StackPanel>
       <TextBlock Grid.Row="1" Text="设置房间名称与密码 →" Foreground="#D9BC75" Margin="0,16,0,0"/>
      </Grid>
     </Button>
     <Button Grid.Column="2" Style="{StaticResource EntryCard}" Click="OpenJoin_Click" AutomationProperties.AutomationId="Rooms.OpenJoin" AutomationProperties.Name="加入房间">
      <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="与队友会合" Foreground="#D9BC75"/><TextBlock Text="加入房间" FontSize="24" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="输入 8 位邀请码。&#10;和队友确认版本，然后一起出发。" Foreground="#ADA99F"/></StackPanel>
       <TextBlock Grid.Row="1" Text="输入邀请码 →" Foreground="#D9BC75" Margin="0,16,0,0"/>
      </Grid>
     </Button>
    </Grid>
   </Grid>
   <Grid Grid.Row="2" x:Name="RoomPanel" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition Height="56"/></Grid.RowDefinitions>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="28"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="RoomTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="返回大厅" Style="{StaticResource Action}" Click="Back_Click" AutomationProperties.AutomationId="Rooms.Back"/><Button x:Name="LeaveButton" Content="退出房间" Style="{StaticResource Action}" Margin="0" Click="Leave_Click" AutomationProperties.AutomationId="Rooms.Leave"/></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="邀请码" Foreground="#ADA99F" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="Invitation" FontSize="16" FontWeight="SemiBold" Foreground="#D9BC75" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button Content="复制" Style="{StaticResource Action}" Height="26" Padding="8,0" Click="CopyCode_Click" AutomationProperties.AutomationId="Rooms.CopyCode"/>
      <Button Content="分享" Style="{StaticResource Action}" Height="26" Padding="8,0" Click="ShareCode_Click" AutomationProperties.AutomationId="Rooms.ShareCode"/>
      <Button Content="邀请好友" Style="{StaticResource Action}" Height="26" Padding="8,0" Click="InviteFriend_Click" AutomationProperties.AutomationId="Rooms.InviteFriend"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="208"/></Grid.ColumnDefinitions>
     <Border x:Name="PlayerPanelSurface" Style="{StaticResource Card}" Padding="8" BorderThickness="0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="24"/><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="GameSummary" Grid.ColumnSpan="3" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock Grid.Row="1" x:Name="PackShare" Text="整合包：未分享" Foreground="#ADA99F" Margin="0,0,8,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="Rooms.PackShare"/>
        <Button Grid.Row="1" Grid.Column="1" x:Name="SharePackButton" Content="分享整合包" Style="{StaticResource Action}" Height="26" Padding="8,0" Click="SharePack_Click" AutomationProperties.AutomationId="Rooms.SharePack"/>
        <Button Grid.Row="1" Grid.Column="2" x:Name="DownloadPackButton" Content="下载" Style="{StaticResource Action}" Height="26" Margin="0" Padding="8,0" Click="DownloadPack_Click" AutomationProperties.AutomationId="Rooms.DownloadPack"/>
        <Button x:Name="JoinHostButton" Content="加入" Style="{StaticResource Action}" Visibility="Collapsed" Click="JoinHost_Click" AutomationProperties.AutomationId="Rooms.JoinHost"/>
       </Grid>
       <TextBlock Grid.Row="1" x:Name="MemberCount" Text="队友" Foreground="#D9BC75" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
       <Grid Grid.Row="2">
        <ItemsControl x:Name="EmptySeats" Visibility="Collapsed" ItemTemplate="{StaticResource EmptySeatTemplate}" IsHitTestVisible="False" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <ItemsControl x:Name="Members" ItemTemplate="{StaticResource MemberTemplate}" AutomationProperties.AutomationId="Rooms.Members"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
       </Grid>
       <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="MemberPrev" Content="‹" Style="{StaticResource Action}" Height="24" Width="28" Padding="0" Click="MemberPrev_Click" AutomationProperties.AutomationId="Rooms.MemberPrev" AutomationProperties.Name="上一页玩家"/>
        <TextBlock x:Name="MemberPageLabel" VerticalAlignment="Center" Margin="8,0,12,0" Foreground="#ADA99F"/>
        <Button x:Name="MemberNext" Content="›" Style="{StaticResource Action}" Height="24" Width="28" Padding="0" Margin="0" Click="MemberNext_Click" AutomationProperties.AutomationId="Rooms.MemberNext" AutomationProperties.Name="下一页玩家"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="8"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
      <Border x:Name="NetworkPanelSurface" Style="{StaticResource Card}" Padding="12" BorderThickness="0">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="连接概要" Foreground="#D9BC75" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="ConnectionSummary" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock Grid.Row="2" x:Name="ConnectionDetail" FontSize="12" Foreground="#ADA99F" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="64" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock Grid.Row="3" x:Name="RoomHealth" FontSize="12" Foreground="#C7C3B8" Margin="0,12,0,0" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
         <Button Content="管理线路" Style="{StaticResource Action}" Margin="0" Click="OpenConnections_Click" AutomationProperties.AutomationId="Rooms.ManageConnections"/>
         <Button x:Name="HostPublishShortcut" Content="LAN 手动 / 已有服务器" Style="{StaticResource Action}" Margin="0,8,0,0" FontSize="12" Padding="4,0" Visibility="Collapsed" Click="OpenRouteEditor_Click" AutomationProperties.AutomationId="Rooms.HostPublishShortcut"/>
        </StackPanel>
       </Grid>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" BorderThickness="0">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="房间聊天" Foreground="#D9BC75" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox Grid.Row="1" x:Name="RoomChat" Background="Transparent" Foreground="#EEECE5" BorderThickness="0" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Rooms.Chat">
         <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontSize="12"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
         <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource Action}" Margin="8,0,0,0" Click="SendChat_Click" AutomationProperties.AutomationId="Rooms.SendChat"/>
         <TextBox x:Name="ChatInput" MaxLength="200" KeyDown="ChatInput_KeyDown" AutomationProperties.AutomationId="Rooms.ChatInput"/>
        </DockPanel>
       </Grid>
      </Border>
     </Grid>

    </Grid>
    <Border Grid.Row="4" Background="#29271F" CornerRadius="6" Padding="12,8">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>
       <TextBlock x:Name="FlowStage" FontSize="14" FontWeight="SemiBold" Foreground="#D9BC75" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock Grid.Row="1" x:Name="FlowHint" FontSize="12" Foreground="#C7C3B8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Grid>
      <Button Grid.Column="1" x:Name="CancelButton" Content="取消" Style="{StaticResource Action}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click" AutomationProperties.AutomationId="Rooms.Cancel"/>
      <Button Grid.Column="2" x:Name="PrimaryAction" Style="{StaticResource Gold}" Height="40" MinWidth="140" MaxWidth="240" Margin="0" Click="PrimaryAction_Click" AutomationProperties.AutomationId="Rooms.PrimaryAction"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <Grid x:Name="Overlay" Visibility="Collapsed" Background="#17191B" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.AutomationId="Rooms.Overlay">
   <Border Style="{StaticResource Card}" x:Name="OverlayFrame" Margin="18" MaxWidth="690" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="关闭 ×" Style="{StaticResource Action}" Click="CloseOverlay_Click" AutomationProperties.AutomationId="Rooms.CloseOverlay"/><TextBlock x:Name="OverlayTitle" FontSize="20" Foreground="#D9BC75"/></DockPanel>
     <Grid Grid.Row="1">
      <StackPanel x:Name="CreateForm" Visibility="Collapsed" MaxWidth="440"><TextBlock Text="房间名称" Style="{StaticResource Label}"/><TextBox x:Name="RoomName" MaxLength="48" AutomationProperties.AutomationId="Rooms.RoomName"/><TextBlock Text="密码（可选；不要复用重要密码）" Style="{StaticResource Label}"/><PasswordBox x:Name="CreatePassword" AutomationProperties.AutomationId="Rooms.CreatePassword"/><TextBlock Text="房间只协调成员；创建后可发布多条游戏线路。" Style="{StaticResource Label}"/><Button Content="创建房间" Margin="0,16,0,0" Style="{StaticResource Gold}" Click="Create_Click" AutomationProperties.AutomationId="Rooms.Create"/></StackPanel>
      <StackPanel x:Name="JoinForm" Visibility="Collapsed" MaxWidth="440"><TextBlock Text="8 位邀请码" Style="{StaticResource Label}"/><TextBox x:Name="RoomCode" MaxLength="8" CharacterCasing="Upper" AutomationProperties.AutomationId="Rooms.Code"/><TextBlock Text="房间密码" Style="{StaticResource Label}"/><PasswordBox x:Name="JoinPassword" AutomationProperties.AutomationId="Rooms.JoinPassword"/><Button Content="加入房间" Margin="0,16,0,0" Style="{StaticResource Gold}" Click="Join_Click" AutomationProperties.AutomationId="Rooms.Join"/></StackPanel>
      <Grid x:Name="SettingsForm" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel x:Name="IdentityPanel"><TextBlock Text="玩家名称（支持离线身份）" Style="{StaticResource Label}"/><TextBox x:Name="PlayerName" Text="Player" MaxLength="32" AutomationProperties.AutomationId="Rooms.PlayerName"/><TextBlock Text="房间中控" Style="{StaticResource Label}"/><ComboBox x:Name="Coordinator" SelectedIndex="0" SelectionChanged="Coordinator_Changed" AutomationProperties.AutomationId="Rooms.Coordinator"><ComboBoxItem Content="官方中控"/><ComboBoxItem Content="自定义中控"/></ComboBox><TextBox x:Name="CustomUrl" Visibility="Collapsed" Margin="0,6,0,0" MaxLength="1024" TextChanged="CustomUrl_Changed" AutomationProperties.AutomationId="Rooms.CustomUrl" AutomationProperties.Name="自定义中控地址"/><TextBlock x:Name="SecurityHint" Style="{StaticResource Label}"/></StackPanel>
       <WrapPanel Grid.Row="1"><Button Content="管理线路" Style="{StaticResource Action}" Margin="0,4,8,0" Click="OpenConnections_Click" AutomationProperties.AutomationId="Rooms.SettingsConnections"/><Button Content="本机工具与节点设置" Style="{StaticResource Action}" Margin="0,4,8,0" Click="OpenTools_Click" AutomationProperties.AutomationId="Rooms.OpenTools"/><Button Content="创建选项 · 名称 / 密码" Style="{StaticResource Action}" Margin="0,4,0,0" IsEnabled="{Binding IsEnabled, ElementName=CreateForm}" Click="OpenCreate_Click" AutomationProperties.AutomationId="Rooms.CreateOptions"/></WrapPanel>
      </Grid>
      <Grid x:Name="ExitForm" Visibility="Collapsed" MaxWidth="520">
       <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="ExitMessage" FontSize="16" LineHeight="26" Margin="0,0,0,24"/>
        <WrapPanel><Button Content="确认退出 / 解散" Style="{StaticResource Gold}" Click="ConfirmExit_Click" AutomationProperties.AutomationId="Rooms.ConfirmExit"/><Button Content="保留房间" Style="{StaticResource Action}" Click="CloseOverlay_Click" AutomationProperties.AutomationId="Rooms.KeepRoom"/></WrapPanel>
       </StackPanel>
      </Grid>
      <Grid x:Name="GameChoiceForm" Visibility="Collapsed" MaxWidth="560">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="0,8,0,20"><TextBlock Text="选择本次使用的游戏" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ChoiceTarget" Foreground="#ADA99F" Margin="0,8,0,0" MaxHeight="90" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
       <ComboBox Grid.Row="1" x:Name="FlowInstanceChoices" SelectionChanged="FlowChoice_Changed" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="Rooms.FlowChoices" AutomationProperties.Name="本次使用的游戏客户端">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <Border Grid.Row="2" Background="#29271F" CornerRadius="4" Padding="12" Margin="0,16,0,0"><TextBlock Text="版本相同不代表模组兼容。请与房主确认整合包、模组及配置；下载整合包不会自动启动游戏。" Foreground="#D9BC75" FontSize="12"/></Border>
       <Button Grid.Row="4" x:Name="FlowConfirm" Content="使用所选游戏继续" Style="{StaticResource Gold}" Height="40" HorizontalAlignment="Right" Margin="0,16,0,0" IsEnabled="False" Click="FlowConfirm_Click" AutomationProperties.AutomationId="Rooms.FlowConfirm"/>
      </Grid>
      <Grid x:Name="ConnectionForm" Visibility="Collapsed">
       <!-- Advanced controls may scroll locally; the room itself always uses stable grid tracks. -->
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,4,0">
         <Grid Height="32" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="HostGame" FontSize="12" Foreground="#ADA99F" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="Rooms.HostGame"/>
          <Border x:Name="EditorCard" Grid.Column="1"><Button Content="发布线路" Style="{StaticResource Action}" Click="OpenRouteEditor_Click" AutomationProperties.AutomationId="Rooms.OpenRouteEditor"/></Border>
          <Button Grid.Column="2" x:Name="RemoveRouteButton" Content="移除所选" Style="{StaticResource Action}" Margin="0" Click="RemoveRoute_Click" AutomationProperties.AutomationId="Rooms.RemoveRoute"/>
         </Grid>
         <Grid Height="180">
          <ListBox x:Name="RouteList" Background="#202224" Foreground="#EEECE5" BorderThickness="0" SelectionChanged="Route_Changed" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Rooms.Routes">
           <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" Rows="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
           <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,4" VerticalAlignment="Center" ToolTip="{Binding Result}">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
            <TextBlock Text="{Binding Endpoint}" Foreground="#C9C5BB" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoint}"/>
            <TextBlock Text="{Binding Result}" FontSize="12" Foreground="#ADA99F" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="NoRoutes" Text="暂无线路，等待房主准备游戏并发布。" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#ADA99F" FontSize="12"/>
         </Grid>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
          <Button x:Name="RoutePrev" Content="‹" Style="{StaticResource Action}" Height="28" Width="32" Padding="0" Click="RoutePrev_Click" AutomationProperties.AutomationId="Rooms.RoutePrev" AutomationProperties.Name="上一页线路"/>
          <TextBlock x:Name="RoutePageLabel" VerticalAlignment="Center" Margin="8,0,12,0" Foreground="#ADA99F"/>
          <Button x:Name="RouteNext" Content="›" Style="{StaticResource Action}" Height="28" Width="32" Padding="0" Margin="0" Click="RouteNext_Click" AutomationProperties.AutomationId="Rooms.RouteNext" AutomationProperties.Name="下一页线路"/>
         </StackPanel>
         <WrapPanel x:Name="ConnectActions" Margin="0,4,0,8">

          <Button Content="自动选路 / 检测" Style="{StaticResource Action}" Click="AutoConnect_Click" AutomationProperties.AutomationId="Rooms.AutoConnect"/>
          <Button Content="检测所选" Style="{StaticResource Action}" Click="ManualConnect_Click" AutomationProperties.AutomationId="Rooms.Connect"/>
          <Button Content="复制地址" Style="{StaticResource Action}" Click="CopyAddress_Click" AutomationProperties.AutomationId="Rooms.CopyAddress"/>
          <Button Content="本机工具" Style="{StaticResource Action}" Margin="0" IsEnabled="{Binding IsEnabled, ElementName=ToolsPanel}" Click="OpenTools_Click" AutomationProperties.AutomationId="Rooms.RoomTools"/>
         </WrapPanel>
         <TextBox x:Name="Endpoint" IsReadOnly="True" FontSize="12" ToolTip="当前已验证的游戏接入地址" AutomationProperties.AutomationId="Rooms.Endpoint"/>
         <Border Background="#202224" CornerRadius="4" Padding="8" Margin="0,12,0,0">
          <Expander x:Name="GameLinkPanel" Header="手动游戏联动 · 选服 / 切服" Foreground="#D9BC75" IsExpanded="False">
           <StackPanel Margin="0,8,0,0">
            <TextBlock Text="运行中的游戏" Style="{StaticResource Label}"/>
            <ComboBox x:Name="GameLinkClients" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="GameLinkClient_Changed" AutomationProperties.AutomationId="Rooms.GameClients"/>
            <TextBlock Text="手动服务器地址" Style="{StaticResource Label}"/>
            <TextBox x:Name="GameLinkAddress" MaxLength="255" ToolTip="服务器域名或 IP，可附带端口；IPv6 使用 [地址]:端口" AutomationProperties.AutomationId="Rooms.GameServer"/>
            <WrapPanel Margin="0,8,0,4">
             <Button Content="启动并进服" Style="{StaticResource Action}" Margin="0,0,4,4" Click="GameLinkLaunch_Click" AutomationProperties.AutomationId="Rooms.GameLaunch"/>
             <Button x:Name="GameLinkConnect" Content="进入 / 切服" Style="{StaticResource Action}" Margin="0,0,4,4" Click="GameLinkConnect_Click" AutomationProperties.AutomationId="Rooms.GameConnect"/>
             <Button x:Name="GameLinkRoom" Content="进入房间线路" Style="{StaticResource Action}" Margin="0,0,4,4" Click="GameLinkRoom_Click" AutomationProperties.AutomationId="Rooms.GameRoom"/>
             <Button x:Name="GameLinkDisconnect" Content="断开游戏" Style="{StaticResource Action}" Margin="0,0,0,4" Click="GameLinkDisconnect_Click" AutomationProperties.AutomationId="Rooms.GameDisconnect"/>
            </WrapPanel>
            <TextBlock x:Name="GameLinkStatus" Text="尚无运行中的游戏；选择版本后可启动并进服。" Foreground="#ADA99F" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="Rooms.GameStatus" AutomationProperties.LiveSetting="Polite"/>
           </StackPanel>
          </Expander>
         </Border>
        </StackPanel>
       </ScrollViewer>
      </Grid>
      <Grid x:Name="RouteEditor" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="1 · 基础" Style="{StaticResource Action}" Click="RouteBasic_Click" AutomationProperties.AutomationId="Rooms.RouteBasic"/><Button Content="2 · 模式参数" Style="{StaticResource Action}" Click="RouteAdvanced_Click" AutomationProperties.AutomationId="Rooms.RouteAdvanced"/><Button Content="3 · 本机工具" Style="{StaticResource Action}" Click="OpenTools_Click" AutomationProperties.AutomationId="Rooms.RouteTools"/></StackPanel>
       <Grid Grid.Row="1"><StackPanel x:Name="RouteBasic"><TextBlock Text="线路名称" Style="{StaticResource Label}"/><TextBox x:Name="RouteName" Text="游戏线路" MaxLength="48" AutomationProperties.AutomationId="Rooms.RouteName"/><TextBlock Text="连接模式" Style="{StaticResource Label}"/><ComboBox x:Name="RouteMode" SelectedIndex="0" SelectionChanged="Mode_Changed" AutomationProperties.AutomationId="Rooms.Mode"><ComboBoxItem Content="IPv6 直连"/><ComboBoxItem Content="自定义 IP"/><ComboBoxItem Content="FRP / TCP"/><ComboBoxItem Content="P2P / XTCP"/><ComboBoxItem Content="ZeroTier"/><ComboBoxItem Content="EasyTier"/></ComboBox><TextBlock Text="本地游戏 / LAN 端口（可手动覆盖）" Style="{StaticResource Label}"/><TextBox x:Name="LocalPort" Text="25565" MaxLength="5" TextChanged="LocalPort_Changed" AutomationProperties.AutomationId="Rooms.LocalPort"/><TextBlock x:Name="PortHint" Text="在游戏内开放局域网后，可重新打开此向导读取端口。" Style="{StaticResource Label}"/></StackPanel>
        <Grid x:Name="RouteAdvanced" Visibility="Collapsed"><StackPanel x:Name="Ipv6Fields"><TextBlock Text="房主公网 IPv6" Style="{StaticResource Label}"/><TextBox x:Name="Ipv6Address" AutomationProperties.AutomationId="Rooms.Ipv6"/><Button Content="重新检测 IPv6" Margin="0,10,0,0" Style="{StaticResource Action}" Click="DetectIpv6_Click"/></StackPanel><StackPanel x:Name="IpFields" Visibility="Collapsed"><TextBlock Text="自定义游戏地址（IPv4、IPv6 或域名，不含端口）" Style="{StaticResource Label}"/><TextBox x:Name="CustomHost" MaxLength="253" AutomationProperties.AutomationId="Rooms.CustomHost" AutomationProperties.Name="自定义 IP"/><TextBlock Text="游戏端口" Style="{StaticResource Label}"/><TextBox x:Name="CustomPort" Text="25565" MaxLength="5" AutomationProperties.AutomationId="Rooms.CustomPort"/></StackPanel><StackPanel x:Name="FrpFields" Visibility="Collapsed"><TextBlock Text="FRP 公网游戏入口主机" Style="{StaticResource Label}"/><TextBox x:Name="PublicHost" AutomationProperties.AutomationId="Rooms.PublicHost"/><TextBlock Text="远程 TCP 端口（由节点分配，不会自动申请）" Style="{StaticResource Label}"/><TextBox x:Name="RemotePort" MaxLength="5" AutomationProperties.AutomationId="Rooms.RemotePort"/></StackPanel><StackPanel x:Name="ZtFields" Visibility="Collapsed"><TextBlock Text="ZeroTier Network ID（16 位十六进制）" Style="{StaticResource Label}"/><TextBox x:Name="NetworkId" MaxLength="16" AutomationProperties.AutomationId="Rooms.NetworkId"/><TextBlock Text="房主虚拟 IP（需在控制台授权）" Style="{StaticResource Label}"/><TextBox x:Name="ZtAddress" AutomationProperties.AutomationId="Rooms.ZtAddress"/><Button Content="读取已加入网络的地址（不加入 / 退出）" Style="{StaticResource Action}" Margin="0,10,0,0" Click="ReadZeroTier_Click" AutomationProperties.AutomationId="Rooms.ReadZeroTier"/></StackPanel>
         <Grid x:Name="EtFields" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="房主 EasyTier 虚拟 IP" Style="{StaticResource Label}"/><TextBox x:Name="EtAddress" Text="10.144.14.1" AutomationProperties.AutomationId="Rooms.EtAddress"/><TextBlock Text="网络名称（留空自动生成）" Style="{StaticResource Label}"/><TextBox x:Name="NetworkName" MaxLength="64" AutomationProperties.AutomationId="Rooms.NetworkName"/><TextBlock Text="网络密码（仅本次房间；留空自动生成）" Style="{StaticResource Label}"/><PasswordBox x:Name="NetworkSecret" AutomationProperties.AutomationId="Rooms.NetworkSecret"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="社区引导节点 URI（每行一个，1–8 个）" Style="{StaticResource Label}"/><TextBox x:Name="Peers" Text="tcp://public.easytier.top:11010" AcceptsReturn="True" Height="110" MaxLength="2056" AutomationProperties.AutomationId="Rooms.Peers"/><TextBlock Text="默认社区节点不保证在线；无 TUN 端口映射，无需 UAC。凭据随线路分享，不持久保存。" Style="{StaticResource Label}"/></StackPanel></Grid>
        </Grid>
       </Grid><StackPanel Grid.Row="2"><TextBlock x:Name="ModeHelp" Style="{StaticResource Label}"/><Button Content="启动本机传输并发布线路" Style="{StaticResource Gold}" Click="AddRoute_Click" AutomationProperties.AutomationId="Rooms.PublishRoute"/></StackPanel>
      </Grid>
      <Grid x:Name="ToolsForm" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TabControl x:Name="ToolsPanel" AutomationProperties.AutomationId="Rooms.LocalTools"><TabItem Header="FRP / P2P"><TabControl><TabItem Header="程序与节点"><StackPanel><TextBlock Text="可信 frpc.exe 路径" Style="{StaticResource Label}"/><DockPanel><Button Content="选择" DockPanel.Dock="Right" Style="{StaticResource Action}" Click="SelectFrpc_Click"/><TextBox x:Name="FrpcPath" MaxLength="1024" AutomationProperties.AutomationId="Rooms.FrpcPath"/></DockPanel><TextBlock Text="frps 控制主机（不同于公网游戏入口）" Style="{StaticResource Label}"/><TextBox x:Name="NodeHost" AutomationProperties.AutomationId="Rooms.NodeHost"/><TextBlock Text="frps 控制端口" Style="{StaticResource Label}"/><TextBox x:Name="NodePort" Text="7000" MaxLength="5" AutomationProperties.AutomationId="Rooms.NodePort"/></StackPanel></TabItem><TabItem Header="安全凭据"><StackPanel><TextBlock Text="frps Token（仅本次会话）" Style="{StaticResource Label}"/><PasswordBox x:Name="NodeToken" MaxLength="512" AutomationProperties.AutomationId="Rooms.NodeToken"/><TextBlock Text="节点 TLS CA 文件（可选）" Style="{StaticResource Label}"/><TextBox x:Name="NodeCa" MaxLength="1024" AutomationProperties.AutomationId="Rooms.NodeCa"/></StackPanel></TabItem></TabControl></TabItem><TabItem Header="EasyTier"><StackPanel><TextBlock Text="可信 easytier-core.exe 路径" Style="{StaticResource Label}"/><DockPanel><Button Content="选择" DockPanel.Dock="Right" Style="{StaticResource Action}" Click="SelectEasyTier_Click"/><TextBox x:Name="EasyTierPath" MaxLength="1024" AutomationProperties.AutomationId="Rooms.EasyTierPath"/></DockPanel><WrapPanel Margin="0,14,0,0"><Button Content="检测工具" Style="{StaticResource Action}" Click="CheckEasyTier_Click" AutomationProperties.AutomationId="Rooms.CheckEasyTier"/><Button Content="获取 EasyTier" Style="{StaticResource Action}" Click="GetEasyTier_Click" AutomationProperties.AutomationId="Rooms.GetEasyTier"/></WrapPanel><TextBlock x:Name="EasyTierToolStatus" Text="选择本机 EasyTier Core，或通过启动器已有的下载任务获取。" Style="{StaticResource Label}" AutomationProperties.AutomationId="Rooms.EasyTierToolStatus"/><TextBlock Text="推荐 2.6.4；检测不加入网络，下载需确认。发布/连接 EasyTier 线路时才启动工具。" Style="{StaticResource Label}"/></StackPanel></TabItem><TabItem Header="ZeroTier"><StackPanel><TextBlock Text="本机 API Token（可选；仅本次会话）" Style="{StaticResource Label}"/><PasswordBox x:Name="ZeroTierToken" MaxLength="512" AutomationProperties.AutomationId="Rooms.ZeroTierToken"/><TextBlock Text="留空时读取 ProgramData 默认文件。读取地址不会静默加入网络。" Style="{StaticResource Label}"/></StackPanel></TabItem></TabControl><Button Grid.Row="1" Content="返回线路向导" Margin="0,10,0,0" Style="{StaticResource Action}" Click="ReturnToRoute_Click" AutomationProperties.AutomationId="Rooms.ReturnToRoute"/></Grid>
     </Grid>
     <DockPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="取消操作" DockPanel.Dock="Right" Style="{StaticResource Action}" Click="Cancel_Click" Visibility="{Binding Visibility, ElementName=CancelButton}" AutomationProperties.AutomationId="Rooms.CancelOverlay"/><TextBlock x:Name="OverlayStatus" Foreground="#D9BC75" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{Binding Text, ElementName=Status}"/></DockPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
