<UserControl x:Class="PCL.HybridAccountOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             AutomationProperties.AutomationId="Hybrid.Account.Overlay">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HybridTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Method" TargetType="Button" BasedOn="{StaticResource Hybrid.QuietButton}">
                <Setter Property="Height" Value="72" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="Backdrop" Background="#C0080A0C" MouseLeftButtonDown="Backdrop_Click" />
        <Border x:Name="Card" Width="920" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#16181C" BorderBrush="#34302A" BorderThickness="1" CornerRadius="8"
                MouseLeftButtonDown="Card_Click">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Hybrid.Account.Title}" Foreground="{StaticResource Hybrid.Text}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Hybrid.Account.SwitchHint}" Foreground="{StaticResource Hybrid.Muted}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" Style="{StaticResource Hybrid.QuietButton}"
                            Width="36" Height="36" Content="×" FontSize="18" AutomationProperties.AutomationId="Hybrid.Account.Close" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LeftPane" Background="#1B1D21" BorderBrush="#2A2D32" BorderThickness="1" CornerRadius="6" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Hybrid.Account.Existing}" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" Margin="2,0,0,10" />
                            <TextBlock x:Name="EmptyAccounts" DockPanel.Dock="Top" Text="{DynamicResource Hybrid.Account.Empty}" Foreground="{StaticResource Hybrid.Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0" Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AccountList" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border x:Name="RightPane" Grid.Column="2" Background="#1B1D21" BorderBrush="#2A2D32" BorderThickness="1" CornerRadius="6" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Hybrid.Account.Create}" Foreground="{StaticResource Hybrid.Text}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Hybrid.Account.CreateHint}" Foreground="{StaticResource Hybrid.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12" />
                            <Button x:Name="BackMethods" DockPanel.Dock="Top" Click="Back_Click" Style="{StaticResource Hybrid.QuietButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="Collapsed"
                                    Content="{DynamicResource Hybrid.Account.Back}" AutomationProperties.AutomationId="Hybrid.Account.Back" />
                            <Grid>
                                <StackPanel x:Name="Methods">
                                    <Button Click="LittleSkin_Click" Style="{StaticResource Method}" AutomationProperties.AutomationId="Hybrid.Account.LittleSkin">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Hybrid.Account.LittleSkin}" Foreground="{StaticResource Hybrid.Accent}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource Hybrid.Account.LittleSkinHint}" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Microsoft_Click" Style="{StaticResource Method}" AutomationProperties.AutomationId="Hybrid.Account.Microsoft">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Hybrid.Account.Microsoft}" Foreground="{StaticResource Hybrid.Text}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource Hybrid.Account.MicrosoftHint}" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Offline_Click" Style="{StaticResource Method}" AutomationProperties.AutomationId="Hybrid.Account.Offline">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Hybrid.Account.Offline}" Foreground="{StaticResource Hybrid.Text}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource Hybrid.Account.OfflineHint}" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Custom_Click" Style="{StaticResource Method}" AutomationProperties.AutomationId="Hybrid.Account.Custom">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Hybrid.Account.Custom}" Foreground="{StaticResource Hybrid.Text}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource Hybrid.Account.CustomHint}" Foreground="{StaticResource Hybrid.Muted}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <ScrollViewer x:Name="CreateScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid x:Name="PanCreateHost" />
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
